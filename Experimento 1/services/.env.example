# Copia este archivo como .env.local y reemplaza los secretos, o ejecuta
# ./scripts/init-local-env.sh para generarlos sin imprimirlos en la terminal.
POSTGRES_USER=solventa_admin
POSTGRES_DB=solventa
POSTGRES_PASSWORD=replace-with-generated-admin-value
DATABASE_ADMIN_URL=postgresql://solventa_admin:replace-with-generated-admin-value@postgres:5432/solventa
RUNTIME_DB_USER=solventa_runtime
RUNTIME_DB_PASSWORD=replace-with-generated-runtime-value
DATABASE_URL=postgresql://solventa_runtime:replace-with-generated-runtime-value@postgres:5432/solventa
REDIS_PASSWORD=replace-with-generated-value
REDIS_URL=redis://:replace-with-generated-value@redis:6379/0
