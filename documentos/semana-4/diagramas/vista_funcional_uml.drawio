        <mxCell id="n217" value="Leyenda de notación UML" style="swimlane;html=1;startSize=28;fontStyle=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;rounded=1;arcSize=3;verticalAlign=top;swimlaneFillColor=none" vertex="1" parent="1"><mxGeometry x="1010" y="1035" width="660" height="130" as="geometry"/></mxCell>
        <mxCell id="n218" value="■  Puerto: punto de interacción con nombre propio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=9;verticalAlign=middle;spacing=3" vertex="1" parent="n217"><mxGeometry x="12" y="30" width="315" height="20" as="geometry"/></mxCell>
        <mxCell id="n219" value="○  Interfaz provista: lo que el componente ofrece" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=9;verticalAlign=middle;spacing=3" vertex="1" parent="n217"><mxGeometry x="12" y="54" width="315" height="20" as="geometry"/></mxCell>
        <mxCell id="n220" value="◖  Interfaz requerida: lo que el componente necesita" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=9;verticalAlign=middle;spacing=3" vertex="1" parent="n217"><mxGeometry x="12" y="78" width="315" height="20" as="geometry"/></mxCell>
        <mxCell id="n221" value="○◖ juntas = conector de ensamblaje (el contrato)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=9;verticalAlign=middle;spacing=3" vertex="1" parent="n217"><mxGeometry x="335" y="30" width="313" height="20" as="geometry"/></mxCell>
        <mxCell id="n222" value="M  Conector de mensajería: comunicación asíncrona" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=9;verticalAlign=middle;spacing=3" vertex="1" parent="n217"><mxGeometry x="335" y="54" width="313" height="20" as="geometry"/></mxCell>
        <mxCell id="n223" value=":Nombre  = instancia de componente en ejecución" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=9;verticalAlign=middle;spacing=3" vertex="1" parent="n217"><mxGeometry x="335" y="78" width="313" height="20" as="geometry"/></mxCell>
        <mxCell id="n224" value="Los puertos y las interfaces no son adorno: son donde vive el argumento de modificabilidad. El componente&lt;br/&gt;:Pagos declara el puerto CobrarPrima en lenguaje de dominio y no conoce ninguna pasarela concreta; los&lt;br/&gt;adaptadores implementan PasarelaPago. Por eso integrar una pasarela nueva no puede obligar a modificar&lt;br/&gt;el núcleo: no existe ninguna arista que salga de él hacia afuera. Ese es el patrón P5 y el ASR-2.1." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fillColor=#fffdf0;strokeColor=#d6b656;fontSize=10;spacing=6" vertex="1" parent="1"><mxGeometry x="60" y="1195" width="900" height="100" as="geometry"/></mxCell>
      </root>
