// Solventa - Vista de asignacion de patrones sobre la arquitectura
// Render:  dot -Tpng -Gdpi=150 vista_patrones.dot -o imagenes/vista_patrones.png
digraph VistaPatrones {
    rankdir=TB;
    compound=true;
    splines=polyline;
    nodesep=0.30;
    ranksep=0.50;
    fontname="Helvetica";
    node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=9 penwidth=0.8 margin="0.14,0.08"];
    edge [fontname="Helvetica" fontsize=8 color="#5A6B7B" penwidth=1.0 arrowsize=0.7];

    subgraph cluster_canales {
        label="  Canales  ";
        fontsize=10; fontname="Helvetica-Bold"; color="#8FA8BF"; style="rounded"; bgcolor="#F4F8FB";
        web    [label="Portal Web\nAngular 17" fillcolor="#D6E9F8" color="#5B9BD5"];
        movil  [label="App Móvil · Kotlin\n{P11 Offline-First}" fillcolor="#D6E9F8" color="#5B9BD5"];
        socios [label="Socios B2B" fillcolor="#D6E9F8" color="#5B9BD5"];
    }

    subgraph cluster_edge {
        label="  Capa Edge  ";
        fontsize=10; fontname="Helvetica-Bold"; color="#C79A3C"; style="rounded"; bgcolor="#FDF8EE";
        gw [label="WAF + API Gateway\nrate limit · authN · TLS 1.3" fillcolor="#FAE6C0" color="#C79A3C"];
    }

    subgraph cluster_bff {
        label="  Capa BFF  ·  {P7 Backend por canal}  ";
        fontsize=10; fontname="Helvetica-Bold"; color="#7C9E5B"; style="rounded"; bgcolor="#F5FAF0";
        bffw [label="BFF Web" fillcolor="#DCEFC8" color="#7C9E5B"];
        bffm [label="BFF Móvil\n{P11 sincronización}" fillcolor="#DCEFC8" color="#7C9E5B"];
    }

    subgraph cluster_core {
        label="  Núcleo de negocio (DDD)  ·  {P4 Mamparo: depósitos separados por dependencia}  ";
        fontsize=10; fontname="Helvetica-Bold"; color="#5B7FA6"; style="rounded"; bgcolor="#EEF4FA";
        cot  [label="Cotización\n& Rating\n{P6 Strategy}" fillcolor="#C9DCF0" color="#4A7EB5"];
        perf [label="Perfilamiento\n& Scoring\n{P1 Cache-Aside}" fillcolor="#C9DCF0" color="#4A7EB5"];
        sus  [label="Suscripción\n& Emisión" fillcolor="#C9DCF0" color="#4A7EB5"];
        pol  [label="Pólizas\n{P10 Firma}" fillcolor="#C9DCF0" color="#4A7EB5"];
        pag  [label="Pagos\n& Recaudo\n{P5 Puerto}" fillcolor="#C9DCF0" color="#4A7EB5"];
        cons [label="Consentimientos\n& Auditoría" fillcolor="#C9DCF0" color="#4A7EB5"];
        tok  [label="Tokenización\n{P9 Custodia única}" fillcolor="#F3C9BA" color="#B5654A"];
    }

    subgraph cluster_plataforma {
        label="  Plataforma de datos  ";
        fontsize=10; fontname="Helvetica-Bold"; color="#9B6BA8"; style="rounded"; bgcolor="#F8F2FA";
        bus   [label="Event Bus Kafka\n{P8 Pub/Sub}" shape=box3d fillcolor="#E5D3EC" color="#9B6BA8"];
        redis [label="Redis\ncaché · TTL 15 min" shape=cylinder fillcolor="#E5D3EC" color="#9B6BA8"];
        pg    [label="PostgreSQL" shape=cylinder fillcolor="#E5D3EC" color="#9B6BA8"];
        s3    [label="S3 + Object Lock\n{P10 WORM}" shape=cylinder fillcolor="#E5D3EC" color="#9B6BA8"];
    }

    subgraph cluster_adapt {
        label="  Adaptadores externos  ·  {P2 Interruptor}  {P3 Timeout + reintento}  {P5 Adapter}  ";
        fontsize=10; fontname="Helvetica-Bold"; color="#B5654A"; style="rounded"; bgcolor="#FCF2EF";
        aof  [label="Open Finance" fillcolor="#F5D5C9" color="#B5654A"];
        aod  [label="Open Data" fillcolor="#F5D5C9" color="#B5654A"];
        akyc [label="KYC / AML" fillcolor="#F5D5C9" color="#B5654A"];
        apay [label="Pasarelas\nde pago" fillcolor="#F5D5C9" color="#B5654A"];
    }

    subgraph cluster_infra {
        label="  Infraestructura  ·  {P12 Multi-AZ activo-activo + autoescalado}  ";
        fontsize=10; fontname="Helvetica-Bold"; color="#E8912D"; style="rounded,dashed"; bgcolor="#FFFCF7";
        eks [label="EKS multi-zona · HPA · health checks" fillcolor="#FAE0BE" color="#E8912D"];
    }

    web    -> gw;
    movil  -> gw;
    socios -> gw;
    gw -> bffw;
    gw -> bffm;
    bffw -> cot;
    bffm -> pol;

    cot  -> perf  [label=" scoring "];
    cot  -> sus   [style=dashed];
    sus  -> pol   [style=dashed];
    sus  -> pag;
    perf -> tok   [label=" tokeniza "];
    cons -> tok;

    perf -> redis [label=" perfil "];
    cot  -> pg;
    pol  -> s3    [label=" firmada "];
    cons -> s3    [label=" auditoría "];
    sus  -> bus   [style=dashed];
    pag  -> bus   [style=dashed];

    perf -> aof;
    perf -> aod;
    sus  -> akyc;
    pag  -> apay;

    pol -> eks [style=invis];
}
