aws_region         = "us-east-1"
aws_profile        = "solventa-lab"
expected_account_id = "969325258550"

# Replace this documentation-only address with the operator's current public IP.
# The configuration rejects 0.0.0.0/0.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]
api_allowed_source_cidrs             = ["203.0.113.10/32"]

# Safe baseline throttle. For the approved 50k laboratory window, use at least
# 1000 RPS / 2000 burst in the untracked terraform.tfvars after checking the
# account quota and downstream capacity.
api_throttling_rate_limit  = 20
api_throttling_burst_limit = 40

eks_version          = "1.36"
vpc_cni_addon_version = "v1.22.4-eksbuild.3"
rds_engine_version   = "15.19"
redis_engine_version = "7.1"

enable_ecs_load_runner = false

# When Fargate is enabled, pin the exact immutable tag or digest produced by
# the image build. Terraform deliberately has no `latest` fallback:
# load_runner_image = "969325258550.dkr.ecr.us-east-1.amazonaws.com/solventa-exp1-load-runner@sha256:..."
