// Solventa - Estructura de los patrones del camino de latencia
// P1 Cache-Aside + P2 Interruptor de circuito + P3 Timeout + P4 Mamparo
// Render:  dot -Tpng -Gdpi=150 patron_latencia.dot -o imagenes/patron_latencia.png
digraph PatronLatencia {
    rankdir=LR;
    splines=polyline;
    nodesep=0.30;
    ranksep=0.55;
    fontname="Helvetica";
    node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=9 penwidth=0.8 margin="0.14,0.08"];
    edge [fontname="Helvetica" fontsize=8 color="#5A6B7B" penwidth=1.0 arrowsize=0.7];

    req  [label="Solicitud de\ncotización" shape=box style="rounded,filled" fillcolor="#E8EDF2" color="#7F8C99"];

    subgraph cluster_p1 {
        label="  P1 · Cache-Aside  ";
        fontsize=10; fontname="Helvetica-Bold"; color="#9B6BA8"; style="rounded"; bgcolor="#F8F2FA";
        lee   [label="¿Perfil en caché\ny vigente?" shape=diamond fillcolor="#E5D3EC" color="#9B6BA8" height=1.0];
        cache [label="Redis\nTTL 15 min" shape=cylinder fillcolor="#E5D3EC" color="#9B6BA8"];
        esc   [label="Escribir perfil\nen caché" fillcolor="#E5D3EC" color="#9B6BA8"];
    }

    subgraph cluster_p2 {
        label="  P2 · Interruptor de circuito  +  P3 · Timeout  ";
        fontsize=10; fontname="Helvetica-Bold"; color="#B5654A"; style="rounded"; bgcolor="#FCF2EF";
        cb    [label="Estado del\ninterruptor" shape=diamond fillcolor="#F3C9BA" color="#B5654A" height=1.0];
        llama [label="Llamar Open Finance\ntimeout 150 ms" fillcolor="#F5D5C9" color="#B5654A"];
        of    [label="Proveedor\nOpen Finance" shape=box3d fillcolor="#F5D5C9" color="#B5654A"];
    }

    subgraph cluster_p4 {
        label="  P4 · Mamparo  ";
        fontsize=10; fontname="Helvetica-Bold"; color="#7C9E5B"; style="rounded"; bgcolor="#F5FAF0";
        pool1 [label="Depósito\nOpen Finance" fillcolor="#DCEFC8" color="#7C9E5B"];
        pool2 [label="Depósito\nPostgreSQL" fillcolor="#DCEFC8" color="#7C9E5B"];
    }

    resp  [label="Prima estimada\np95 < 200 ms" fillcolor="#C9DCF0" color="#4A7EB5"];
    degr  [label="Prima preliminar\ndesde caché\n(modo degradado)" fillcolor="#FAE6C0" color="#C79A3C"];
    pg    [label="PostgreSQL\nfuente primaria" shape=cylinder fillcolor="#C9DCF0" color="#4A7EB5"];

    req  -> lee;
    lee  -> cache  [label=" consulta "];
    lee  -> resp   [label=" acierto (80%) \n < 20 ms " color="#2E7D32" fontcolor="#2E7D32"];
    lee  -> cb     [label=" ausencia "];

    cb   -> llama  [label=" cerrado "];
    cb   -> degr   [label=" abierto \n falla rápido " color="#B5654A" fontcolor="#B5654A"];
    llama -> pool1 [style=dashed label=" usa "];
    llama -> of;
    of   -> esc    [label=" respuesta "];
    esc  -> cache  [style=dashed];
    esc  -> resp;
    llama -> degr  [label=" timeout \n 150 ms " style=dashed color="#B5654A" fontcolor="#B5654A"];

    degr -> pg     [label=" fallback si \n no hay caché "];
    pg   -> pool2  [style=dashed label=" usa "];
    pg   -> resp;
}
