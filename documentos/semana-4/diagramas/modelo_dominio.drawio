        <mxCell id="n102" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br/&gt;— id&lt;br/&gt;— nombre&lt;br/&gt;— documento (tokenizado)&lt;br/&gt;— canal: web | móvil" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#4a7eb5;fontSize=11;verticalAlign=middle;spacing=3" vertex="1" parent="1"><mxGeometry x="60" y="90" width="250" height="130" as="geometry"/></mxCell>
